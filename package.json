{
  "name": "pagedown",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "predev": "pnpm run build:pagination-render",
    "dev": "electron-vite dev",
    "prestart": "pnpm run build:pagination-render",
    "build:pagination-render": "tsx scripts/build-pagination-render.ts",
    "build": "pnpm run typecheck && electron-vite build && pnpm run build:pagination-render",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && pnpm run build:pagination-render && electron-builder --mac",
    "build:linux": "electron-vite build && pnpm run build:pagination-render && electron-builder --linux",
    "test:unit": "vitest run",
    "test:phase1:vitest": "vitest run --config vitest.phase1.config.ts",
    "pretest:phase1:playwright": "pnpm run build",
    "test:phase1:playwright": "playwright test --config=playwright.phase1.config.ts",
    "pretest:phase0": "pnpm run build",
    "test:phase0": "playwright test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@milkdown/core": "7.21.3",
    "@milkdown/ctx": "7.21.3",
    "@milkdown/plugin-listener": "7.21.3",
    "@milkdown/preset-commonmark": "7.21.3",
    "@milkdown/preset-gfm": "7.21.3",
    "@milkdown/utils": "7.21.3",
    "decode-named-character-reference": "^1.3.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-sanitize": "^5.0.2",
    "js-yaml": "^5.2.2",
    "mermaid": "11.4.1",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "pagedjs": "0.4.3",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "mdast-util-to-hast": "^13.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
